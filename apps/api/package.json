{
  "name": "@socialmesh/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run src/lib/postiz/postiz.test.ts",
    "test:smoke": "tsx scripts/postiz-smoke.ts",
    "lint": "tsc -p tsconfig.json --noEmit --pretty false",
    "prisma:generate": "prisma generate",
    "prisma:bootstrap": "tsx scripts/db-bootstrap.ts",
    "prisma:migrate:deploy": "tsx scripts/db-bootstrap.ts && prisma migrate deploy",
    "prisma:migrate": "tsx scripts/db-bootstrap.ts && prisma migrate dev",
    "db:setup": "tsx scripts/db-bootstrap.ts && prisma migrate deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1138.0",
    "@aws-sdk/s3-request-presigner": "^3.1138.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
