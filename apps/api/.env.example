# Node Environment
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.region.aws.neon.tech/neondb?sslmode=require"

# Application Secrets (32-byte hex/base64 strings)
SESSION_SECRET="replace-with-random-secret"
TOKEN_ENCRYPTION_KEY="replace-with-base64-key"

# Cloudflare R2
R2_ACCOUNT_ID="replace-with-account-id"
R2_ACCESS_KEY_ID="replace-with-access-key-id"
R2_SECRET_ACCESS_KEY="replace-with-secret-access-key"
R2_BUCKET_NAME="socialmesh-media"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"

# Postiz Headless Publishing Engine (Backend-only; never expose to web)
POSTIZ_BASE_URL="http://localhost:3000"
POSTIZ_API_KEY="replace-with-postiz-api-key"
POSTIZ_TIMEOUT_MS=10000

